{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign all_images = ''
  for i in (1..24)
    assign image_key = 'image_' | append: i
    assign image = block.settings[image_key]
    if image != blank
      if all_images == ''
        assign all_images = image_key
      else
        assign all_images = all_images | append: ',' | append: image_key
      endif
    endif
  endfor
  assign image_array = all_images | split: ','
  assign total_images = image_array.size

  assign desktop_cells = block.settings.desktop_columns | times: block.settings.desktop_rows
  assign tablet_cells = block.settings.tablet_columns | times: block.settings.tablet_rows
  assign mobile_cells = block.settings.mobile_columns | times: block.settings.mobile_rows
  
  if desktop_cells > 24
    assign desktop_cells = 24
  endif
  if tablet_cells > 24
    assign tablet_cells = 24
  endif
  if mobile_cells > 24
    assign mobile_cells = 24
  endif
%}

{% style %}
  .ai-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    position: relative;
  }

  .ai-gallery-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .ai-gallery-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    text-align: center;
    margin: 0;
    position: relative;
    z-index: 10;
    opacity: {{ block.settings.heading_opacity | divided_by: 100.0 }};
    transform: translateY({{ block.settings.heading_offset }}px);
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    color: {{ block.settings.heading_color }};
    margin-bottom: {{ block.settings.heading_offset | times: -1 | plus: 20 }}px;
  }

  .ai-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.grid_gap }}px;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    grid-template-rows: repeat({{ block.settings.desktop_rows }}, 1fr);
    grid-auto-rows: 0;
    overflow: hidden;
  }

  @media screen and (max-width: 989px) {
    .ai-gallery-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.tablet_columns }}, 1fr);
      grid-template-rows: repeat({{ block.settings.tablet_rows }}, 1fr);
    }

    .ai-gallery-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
      grid-template-rows: repeat({{ block.settings.mobile_rows }}, 1fr);
    }

    .ai-gallery-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.5);
    }

    .ai-gallery-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 15px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }
  }

  .ai-gallery-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .ai-gallery-item-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .ai-gallery-item-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ai-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ai-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ai-gallery-image-{{ ai_gen_id }}.ai-active {
    opacity: 1;
    transform: scale(1);
    z-index: 2;
  }

  .ai-gallery-image-{{ ai_gen_id }}.ai-inactive {
    opacity: 0;
    transform: scale(1.1);
    z-index: 1;
  }

  .ai-gallery-item-{{ ai_gen_id }}:hover .ai-gallery-image-{{ ai_gen_id }}.ai-active {
    transform: scale(1.05);
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    position: relative;
  }

  .ai-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-gallery-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  @media screen and (min-width: 990px) {
    .ai-gallery-item-{{ ai_gen_id }}:nth-child(n + {{ desktop_cells | plus: 1 }}) {
      display: none;
    }
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    .ai-gallery-item-{{ ai_gen_id }}:nth-child(n + {{ tablet_cells | plus: 1 }}) {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gallery-item-{{ ai_gen_id }}:nth-child(n + {{ mobile_cells | plus: 1 }}) {
      display: none;
    }
  }
{% endstyle %}

<gallery-block-{{ ai_gen_id }} 
  class="ai-gallery-{{ ai_gen_id }}" 
  data-total-images="{{ total_images }}"
  data-desktop-cells="{{ desktop_cells }}"
  data-tablet-cells="{{ tablet_cells }}"
  data-mobile-cells="{{ mobile_cells }}"
  data-rotation-speed="{{ block.settings.rotation_speed }}"
  data-image-data="{% for image_key in image_array %}{% assign img = block.settings[image_key] %}{% if img != blank %}{{ image_key }}::{{ img | image_url: width: 800 }}::{{ img.alt | escape }}{% unless forloop.last %}||{% endunless %}{% endif %}{% endfor %}"
  {{ block.shopify_attributes }}
>
  <div class="ai-gallery-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-gallery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-gallery-grid-{{ ai_gen_id }}">
      {% if total_images > 0 %}
        {% for i in (1..24) %}
          <div class="ai-gallery-item-{{ ai_gen_id }}" data-cell-index="{{ forloop.index0 }}">
            <div class="ai-gallery-item-link-{{ ai_gen_id }}">
              <div class="ai-gallery-image-wrapper-{{ ai_gen_id }}">
                <img
                  src=""
                  alt=""
                  loading="lazy"
                  width="800"
                  height="800"
                  class="ai-gallery-image-{{ ai_gen_id }} ai-active"
                  data-slot="active"
                >
                <img
                  src=""
                  alt=""
                  loading="lazy"
                  width="800"
                  height="800"
                  class="ai-gallery-image-{{ ai_gen_id }} ai-inactive"
                  data-slot="inactive"
                >
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="ai-gallery-item-{{ ai_gen_id }}">
          <div class="ai-gallery-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-gallery-empty-state-{{ ai_gen_id }}">
              Add images below
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</gallery-block-{{ ai_gen_id }}>

<script>
  (function() {
    class GalleryBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.intervals = [];
        this.allImages = [];
        this.currentlyVisible = new Set();
      }

      connectedCallback() {
        this.parseImageData();
        const totalImages = parseInt(this.dataset.totalImages) || 0;
        const rotationSpeed = parseInt(this.dataset.rotationSpeed) || 5;
        this.rotationInterval = rotationSpeed * 1000;
        
        if (totalImages > 0) {
          this.initializeGrid();
          if (totalImages > 1) {
            this.startRotation();
          }
        }
      }

      disconnectedCallback() {
        this.intervals.forEach(interval => clearInterval(interval));
        this.intervals = [];
      }

      parseImageData() {
        const imageData = this.dataset.imageData || '';
        if (!imageData) return;

        const imageEntries = imageData.split('||');
        this.allImages = imageEntries.map(entry => {
          const parts = entry.split('::');
          return {
            key: parts[0],
            src: parts[1],
            alt: parts[2] || ''
          };
        }).filter(img => img.src);
      }

      shuffleArray(array) {
        const shuffled = [...array];
        for (let i = shuffled.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled;
      }

      initializeGrid() {
        const cells = this.querySelectorAll('.ai-gallery-item-{{ ai_gen_id }}');
        const visibleCells = this.getVisibleCells();
        
        const shuffledImages = this.shuffleArray(this.allImages);
        
        cells.forEach((cell, index) => {
          if (index < visibleCells && index < shuffledImages.length) {
            const activeImg = cell.querySelector('[data-slot="active"]');
            const inactiveImg = cell.querySelector('[data-slot="inactive"]');
            
            const initialImage = shuffledImages[index];
            activeImg.src = initialImage.src;
            activeImg.alt = initialImage.alt;
            activeImg.dataset.imageKey = initialImage.key;
            
            this.currentlyVisible.add(initialImage.key);
            
            if (this.allImages.length > 1) {
              const nextImage = this.getNextUniqueImage(initialImage.key);
              if (nextImage) {
                inactiveImg.src = nextImage.src;
                inactiveImg.alt = nextImage.alt;
                inactiveImg.dataset.imageKey = nextImage.key;
              }
            }
          }
        });
      }

      getVisibleCells() {
        const width = window.innerWidth;
        if (width >= 990) {
          return parseInt(this.dataset.desktopCells) || 12;
        } else if (width >= 750) {
          return parseInt(this.dataset.tabletCells) || 9;
        } else {
          return parseInt(this.dataset.mobileCells) || 4;
        }
      }

      startRotation() {
        const cells = this.querySelectorAll('.ai-gallery-item-{{ ai_gen_id }}');
        const visibleCells = this.getVisibleCells();
        
        cells.forEach((cell, index) => {
          if (index < visibleCells && this.allImages.length > 1) {
            const delay = Math.random() * 2000;
            
            setTimeout(() => {
              const interval = setInterval(() => {
                this.rotateCell(cell);
              }, this.rotationInterval);
              
              this.intervals.push(interval);
            }, delay);
          }
        });
      }

      rotateCell(cell) {
        const wrapper = cell.querySelector('.ai-gallery-image-wrapper-{{ ai_gen_id }}');
        const activeImg = wrapper.querySelector('[data-slot="active"]');
        const inactiveImg = wrapper.querySelector('[data-slot="inactive"]');
        
        if (!activeImg || !inactiveImg) return;

        const currentKey = activeImg.dataset.imageKey;
        const nextKey = inactiveImg.dataset.imageKey;
        
        if (!nextKey) return;

        requestAnimationFrame(() => {
          activeImg.classList.remove('ai-active');
          activeImg.classList.add('ai-inactive');
          inactiveImg.classList.remove('ai-inactive');
          inactiveImg.classList.add('ai-active');

          activeImg.dataset.slot = 'inactive';
          inactiveImg.dataset.slot = 'active';

          this.currentlyVisible.delete(currentKey);
          this.currentlyVisible.add(nextKey);

          const futureImage = this.getNextUniqueImage(nextKey);
          if (futureImage) {
            activeImg.src = futureImage.src;
            activeImg.alt = futureImage.alt;
            activeImg.dataset.imageKey = futureImage.key;
          }
        });
      }

      getNextUniqueImage(currentKey) {
        const availableImages = this.allImages.filter(img => 
          img.key !== currentKey && !this.currentlyVisible.has(img.key)
        );

        if (availableImages.length === 0) {
          const fallbackImages = this.allImages.filter(img => img.key !== currentKey);
          if (fallbackImages.length === 0) return null;
          
          const randomIndex = Math.floor(Math.random() * fallbackImages.length);
          return fallbackImages[randomIndex];
        }

        const randomIndex = Math.floor(Math.random() * availableImages.length);
        return availableImages[randomIndex];
      }
    }

    customElements.define('gallery-block-{{ ai_gen_id }}', GalleryBlock{{ ai_gen_id }});
  })();
</script>

