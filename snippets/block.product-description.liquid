{%- comment -%}
  Renders the product description

  Accepts:
  - block {block} - Block object
  - product {product} - Product object
  - is_tab {boolean} - Whether to render as a tab

  Usage:
  {% render 'block.product-description', block: block %}
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product | default: product
  assign is_tab = is_tab | default: block.settings.is_tab, allow_false: true | default: true, allow_false: true
  assign description = 'info.placeholder_product_description' | t

  if product
    assign description = product.description
  endif

  if is_tab
    capture accordion_title
      render 'utility.translate', key: 'labels.description', fallback: 'Description'
    endcapture
  endif
-%}

<div style="width: 100%;" {{ block.shopify_attributes }}>
  {%- liquid
    if is_tab
      render 'element.accordion', title: accordion_title, slot: description
    else
      render 'element.text', text: description, variant: 'rte'
    endif
  -%}
  {%- unless is_tab -%}
    <script>
      (() => {
        const root = document.currentScript.closest('div');
        const rte = root && root.querySelector('element-text-rte');
        if (!rte || rte.querySelector('.product-detail-spec')) return;

        const childNodes = Array.from(rte.childNodes);
        const children = childNodes.filter((node) => node.nodeType === Node.ELEMENT_NODE);
        const paragraphs = children.filter((element) => element.matches('p'));
        const normalize = (value) => value.replace(/\u00a0/g, ' ').trim();
        const textOf = (node) => node ? (node.innerText || node.textContent || '') : '';
        const findParagraph = (matcher) => paragraphs.find((paragraph) => matcher(normalize(paragraph.innerText || '')));
        const findChild = (matcher) => childNodes.find((node) => matcher(normalize(textOf(node))));
        const detailsParagraph = findParagraph((text) => text.startsWith('Details:'));
        const naturalParagraph = findParagraph((text) => text.startsWith('Natural Side Diamonds:'));
        const labParagraph = findParagraph((text) => text.startsWith('Lab Side Diamonds:'));
        const naturalDiamondParagraph = findChild((text) => text.startsWith('Natural Diamond'));
        const labDiamondParagraph = findChild((text) => text.startsWith('Lab Diamond'));
        const priceParagraph = findParagraph((text) => text.includes('Price is for setting only'));
        const specialOrderElement = findChild((text) => text.includes('modified to your preferences') && text.includes('special order'));
        const hasAddDiamond = Boolean(document.querySelector('#add-diamond-link'));

        if (!detailsParagraph && !naturalParagraph && !labParagraph) return;

        const linesFrom = (node, heading) => {
          if (!node) return [];
          return normalize(textOf(node))
            .split('\n')
            .map((line) => normalize(line))
            .filter(Boolean)
            .filter((line) => line !== heading);
        };

        const isSpecLine = (line) => {
          const label = normalize(line.split(':')[0] || '').toLowerCase();
          return [
            'band width',
            'number of side diamonds',
            'side diamonds',
            'number of diamonds',
            'total carat weight',
            'diamond color',
            'diamond clarity',
            'igi certified',
            'chain width',
            'chain length',
            'metal',
            'stone',
            'center stone',
            'diamond',
            'dimensions',
            'width',
            'length',
            'setting'
          ].includes(label);
        };

        const looseDetailNodes = [];
        const looseDetailLines = [];
        const collectLooseDetailsAfter = (anchor) => {
          let node = anchor && anchor.nextSibling;
          while (node) {
            const text = normalize(textOf(node));
            const lines = text
              .split('\n')
              .map((line) => normalize(line))
              .filter(Boolean);

            if (lines.some((line) => /^(Natural Side Diamonds|Lab Side Diamonds|Natural Diamond|Lab Diamond)\b/.test(line))) break;

            const specLines = lines.filter(isSpecLine);
            if (specLines.length) {
              looseDetailLines.push(...specLines);
              if (specLines.length === lines.length) looseDetailNodes.push(node);
            }

            node = node.nextSibling;
          }
        };

        const escapeHtml = (value) => value
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

        const toRows = (lines) => lines.map((line) => {
          const splitAt = line.indexOf(':');
          if (splitAt === -1) return `<div class="product-detail-spec__row"><span>${escapeHtml(line)}</span></div>`;
          const label = escapeHtml(line.slice(0, splitAt).trim());
          const value = escapeHtml(line.slice(splitAt + 1).trim());
          return `<div class="product-detail-spec__row"><span>${label}</span><strong>${value}</strong></div>`;
        }).join('');

        collectLooseDetailsAfter(detailsParagraph);

        const detailLines = [
          ...linesFrom(detailsParagraph, 'Details:'),
          ...looseDetailLines
        ].filter((line) => !line.toLowerCase().includes('price is for setting only'));
        const naturalLines = linesFrom(naturalParagraph, 'Natural Side Diamonds:');
        const labLines = linesFrom(labParagraph, 'Lab Side Diamonds:');
        const naturalDiamondLines = linesFrom(naturalDiamondParagraph, 'Natural Diamond');
        const labDiamondLines = linesFrom(labDiamondParagraph, 'Lab Diamond');
        const isDiamondLine = (line) => {
          const label = normalize(line.split(':')[0] || line).toLowerCase();
          return ['diamond', 'stone', 'clarity', 'color', 'carat', 'ctw', 'igi', 'certificate', 'certified'].some((term) => label.includes(term));
        };
        const diamondInfoLines = hasAddDiamond ? [] : [...detailLines.filter(isDiamondLine), ...naturalLines, ...labLines];
        const settingLines = hasAddDiamond ? detailLines : detailLines.filter((line) => !isDiamondLine(line));
        const group = (title, lines) => lines.length
          ? `<section class="product-detail-spec__group"><h3>${title}</h3>${toRows(lines)}</section>`
          : '';
        const priceLine = priceParagraph
          ? linesFrom(priceParagraph, 'Details:').find((line) => line.toLowerCase().includes('price is for setting only'))
          : '';
        const priceNote = hasAddDiamond
          ? escapeHtml(normalize(priceLine || 'Price is for setting only').replace(/^["\u201C]|["\u201D]$/g, ''))
          : '';
        const specTitle = hasAddDiamond ? 'Setting specification' : 'Product specification';
        const spec = document.createElement('div');
        spec.className = 'product-detail-spec';
        spec.innerHTML = `
          <div class="product-detail-spec__header">
            <span>Product details</span>
            <strong>${specTitle}</strong>
          </div>
          <div class="product-detail-spec__grid">
            ${group('Setting', settingLines)}
            ${hasAddDiamond ? group('Natural side diamonds', naturalLines) : ''}
            ${hasAddDiamond ? group('Lab side diamonds', labLines) : group('Diamond information', diamondInfoLines)}
            ${!hasAddDiamond ? group('Natural diamond', naturalDiamondLines) : ''}
            ${!hasAddDiamond ? group('Lab diamond', labDiamondLines) : ''}
          </div>
          ${priceNote ? `<div class="product-detail-spec__note">${priceNote}</div>` : ''}
          ${!hasAddDiamond && specialOrderElement ? `<div class="product-detail-spec__note">${escapeHtml(normalize(specialOrderElement.innerText || ''))}</div>` : ''}
        `;

        (detailsParagraph || naturalParagraph || labParagraph).before(spec);
        [detailsParagraph, naturalParagraph, labParagraph, naturalDiamondParagraph, labDiamondParagraph, priceParagraph, specialOrderElement, ...looseDetailNodes].forEach((element) => element && element.remove());
      })();
    </script>
  {%- endunless -%}
</div>
