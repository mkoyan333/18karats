{%- comment -%}
  Renders the mobile header navigation.

  Accepts:
  - container {string} - The container ID
  - main_menu {linklist} - The main menu object
  - text_direction {string} - The text direction of the store
  - in_header {boolean} - Whether the mobile nav is in the header

  Usage:
  {% render 'header.mobile-nav', container: 'MobileNav' %}
{%- endcomment -%}

{% stylesheet %}
	/*Height changes based on active subnav*/
	.slide-nav__wrapper {
	  --color-primary: #20312d;
	  --color-secondary: #ffffff;
	  --element-text-color: #20312d;
	  --z-index-overlay: 1;
	  position: relative;
	  overflow: hidden;
	  display: block;
	  background: #ffffff !important;
	  color: #20312d !important;
	
	  &:after {
	    background-color: rgba(0, 0, 0, 0.027);
	    pointer-events: none;
	    border-radius: var(--roundness);
	  }
	}
	
	/*Element slides left/right to reveal current nav level*/
	.slide-nav {
	  margin: 0;
	  padding: 14px 14px 24px;
	  list-style: none;
	  transition: transform var(--slide-curve);
	
	  [data-level='2'] & {
	    transform: translateX(-100%);
	  }
	
	  [data-level='3'] & {
	    transform: translateX(-200%);
	  }
	}
	
	/*button element cannot be flex, so make invisible and style child*/
	.slide-nav__button {
	  display: block;
	  background: none;
	  border: 0;
	  padding: 0;
	  width: 100%;
	  text-align: left;
	
	  [dir='rtl'] & {
	    text-align: right;
	  }
	}
	
	.slide-nav__link {
	  position: relative;
	  display: flex;
	  width: 100%;
	  padding: 13px 22px;
	  align-items: center;
	  justify-content: space-between;
	  font-size: calc(var(--element-text-font-size--body-md) + 1px);
	  line-height: 1.25;
	  border-radius: 0;
	  transition:
	    background-color 0.18s ease,
	    color 0.18s ease;

	  &:hover,
	  &:focus-visible {
	    background: color-mix(in srgb, currentColor 6%, transparent);
	    text-decoration: none;
	  }
	
	  & > span {
	    display: block;
	    flex: 1 1 auto;
	    min-width: 0;
	  }
	
	  & .element-icon {
	    width: 11px;
	    height: 11px;
	    margin-left: 10px;
	  }
	}
	
	/*Collection link image*/
	.slide-nav__image {
	  position: absolute;
	  width: 40px;
	  height: 40px;
	  left: 15px;
	  top: 50%;
	  margin-top: -20px;
	
	  & img {
	    object-fit: cover;
	    width: 100%;
	    height: 100%;
	  }
	
	  & + span {
	    padding-left: 45px;
	  }
	}
	
	/*Slightly different style, icon on left*/
	.slide-nav__link--back {
	  margin-bottom: 8px;
	  padding-top: 18px;
	  padding-bottom: 16px;
	  border-bottom: 1px solid color-mix(in srgb, currentColor 13%, transparent);
	  font-weight: var(--element-text-font-weight--heading);
	  justify-content: flex-start;
	  letter-spacing: 0;
	  text-transform: uppercase;
	
	  & > span {
	    text-decoration: none;
	  }
	
	  & .element-icon {
	    margin-right: 15px;
	    margin-left: 0;
	    transform: rotate(180deg);
	  }
	}
	
	/*list item*/
	.slide-nav__item {
	  display: block;
	  width: 100%;
	  margin: 0;
	
	  &:first-child {
	    padding-top: 10px;
	  }
	
	  &:last-child {
	    padding-bottom: 10px;
	  }
	}

	.slide-nav > .slide-nav__item {
	  padding: 0;
	}

	.slide-nav > .slide-nav__item + .slide-nav__item {
	  margin-top: 8px;
	}

	.slide-nav > .slide-nav__item > .slide-nav__button > .slide-nav__link,
	.slide-nav > .slide-nav__item > .slide-nav__link {
	  min-height: 62px;
	  padding: 12px 14px;
	  border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
	  border-radius: 8px;
	  background:
	    linear-gradient(90deg, color-mix(in srgb, currentColor 5%, #ffffff), #ffffff 42%);
	  font-weight: var(--element-text-font-weight--heading);
	  color: #20312d;
	  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.035);
	}

	.slide-nav > .slide-nav__item > .slide-nav__button > .slide-nav__link:hover,
	.slide-nav > .slide-nav__item > .slide-nav__button > .slide-nav__link:focus-visible,
	.slide-nav > .slide-nav__item > .slide-nav__link:hover,
	.slide-nav > .slide-nav__item > .slide-nav__link:focus-visible {
	  background: color-mix(in srgb, currentColor 5%, #ffffff);
	}

	.slide-nav > .slide-nav__item > .slide-nav__button > .slide-nav__link > span,
	.slide-nav > .slide-nav__item > .slide-nav__link > span {
	  font-size: calc(var(--element-text-font-size--body-md) + 1px);
	  line-height: 1.2;
	}

	.slide-nav__root-icon {
	  display: inline-flex;
	  align-items: center;
	  justify-content: center;
	  flex: 0 0 36px;
	  width: 36px;
	  height: 36px;
	  margin-right: 12px;
	  border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
	  border-radius: 8px;
	  background: #ffffff;
	  color: #20312d;
	}

	.slide-nav__root-icon .element-icon {
	  width: 17px;
	  height: 17px;
	  margin: 0;
	}

	.slide-nav__root-text {
	  display: flex;
	  align-items: center;
	  min-width: 0;
	}

	.slide-nav > .slide-nav__item:nth-child(n + 4) > .slide-nav__link {
	  min-height: 54px;
	  background: #ffffff;
	  box-shadow: none;
	}

	.slide-nav__item--divider {
	  margin: 10px 20px 0;
	  padding-top: 10px;
	  border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
	}

	.slide-nav__item--divider > .slide-nav__button > .slide-nav__link {
	  padding-left: 0;
	  padding-right: 0;
	  font-size: calc(var(--element-text-font-size--body-md) - 1px);
	  font-weight: var(--element-text-font-weight--heading);
	  letter-spacing: 0;
	  text-transform: uppercase;
	}

	.slide-nav__item--divider > .slide-nav__button > .slide-nav__link:hover,
	.slide-nav__item--divider > .slide-nav__button > .slide-nav__link:focus-visible {
	  background: transparent;
	}

	.slide-nav__link--icon {
	  justify-content: flex-start;
	  gap: 0;
	  min-height: 48px;
	  padding-top: 10px;
	  padding-bottom: 10px;
	  font-size: calc(var(--element-text-font-size--body-md) - 1px);
	}

	.slide-nav__link--icon .shape-menu-icon {
	  --shape-menu-icon-size: 22px;
	  opacity: 0.8;
	}

	.slide-nav__dropdown--icon-grid.is-active {
	  display: grid !important;
	  grid-template-columns: repeat(2, minmax(0, 1fr));
	  gap: 8px;
	  padding: 0 14px 24px;
	}

	.slide-nav__dropdown--icon-grid > .slide-nav__item {
	  padding: 0;
	}

	.slide-nav__dropdown--icon-grid > .slide-nav__item:first-child,
	.slide-nav__dropdown--icon-grid > .slide-nav__item--full {
	  grid-column: 1 / -1;
	}

	.slide-nav__dropdown--icon-grid .slide-nav__link--icon {
	  height: 54px;
	  padding: 10px 9px;
	  border: 1px solid color-mix(in srgb, currentColor 13%, transparent);
	  border-radius: 8px;
	  background: #ffffff;
	  font-size: calc(var(--element-text-font-size--body-sm) + 1px);
	}

	.slide-nav__dropdown--icon-grid .slide-nav__link--icon:hover,
	.slide-nav__dropdown--icon-grid .slide-nav__link--icon:focus-visible {
	  background: color-mix(in srgb, currentColor 5%, #ffffff);
	}
	
	.slide-nav__dropdown {
	  display: none;
	  visibility: hidden;
	  position: absolute;
	  width: 100%;
	  top: 0;
	  right: -100%;
	  margin: 0;
	  opacity: 0;
	  transition: all var(--slide-curve);
	
	  &.is-active {
	    display: block;
	    visibility: visible;
	    opacity: 1;
	    transition: all 0.55s cubic-bezier(0.165, 0.84, 0.44, 1) 0.1s forwards;
	  }
	}
	
	/*Adjustments to footer menus when inside mobile nav*/
	.site-header__mobile-nav .footer__section--menus {
	  margin-top: 20px;
	  margin-left: calc(var(--page-width-padding) * -1);
	  margin-right: calc(var(--page-width-padding) * -1);
	}
{% endstylesheet %}

{%- liquid
  assign main_menu = main_menu | default: section.settings.main_menu_link_list
  assign text_direction = text_direction | default: settings.text_direction
  assign in_header = in_header | default: false, allow_false: true

  if text_direction == 'rtl'
    assign chevron_icon = 'chevron-left'
  else
    assign chevron_icon = 'chevron-right'
  endif
-%}

<mobile-nav
  class="slide-nav__wrapper overlay"
  data-level="1"
  container="{{ container }}"
  inHeader="{{ in_header }}"
  defer-hydration
>
  <ul class="slide-nav">
    {%- for link in main_menu.links -%}
      {%- liquid
        assign link_index = forloop.index
        assign child_list_handle = link.title | handleize | append: link_index

        assign is_by_shape_menu_item = false
        assign title_normalized = link.title | downcase | strip
        if title_normalized == 'by shape' or title_normalized == 'по форме'
          assign is_by_shape_menu_item = true
        endif

        assign root_icon_name = 'arrow-right'
        if title_normalized contains 'engagement'
          assign root_icon_name = 'heart'
        elsif title_normalized contains 'jewelry'
          assign root_icon_name = 'star'
        elsif title_normalized contains 'diamond'
          assign root_icon_name = 'shape-round'
        elsif title_normalized contains 'about'
          assign root_icon_name = 'shield'
        elsif title_normalized contains 'gallery'
          assign root_icon_name = 'view-small'
        elsif title_normalized contains 'contact'
          assign root_icon_name = 'phone'
        endif

        assign is_collection = false
        assign have_image = false
        if link.url contains '/collections/'
          assign lang_code_string = request.locale.iso_code | prepend: '/' | downcase
          assign subcollection_handle = link.url | remove: '/collections/' | remove: lang_code_string
          assign subcollection_drop = collections[subcollection_handle]
          assign is_collection = true
        endif
      -%}

      {%- if have_image -%}
        {%- capture collection_image -%}
          <div class="slide-nav__image">
            {%- render 'element.image',
              img: have_image,
              loading: 'eager',
              sizes: '40px',
              alt: collections[subcollection_handle].title,
            -%}
          </div>
        {%- endcapture -%}
      {%- endif -%}

      <li class="slide-nav__item">
        {%- if link.levels > 0 -%}
          <button
            type="button"
            class="slide-nav__button js-toggle-submenu"
            data-target="tier-2-{{ child_list_handle }}"
            {% if link.active or link.child_active %}
              data-active="true"
            {% endif %}
          >
            <span class="slide-nav__link slide-nav__link--root">
              {%- if have_image -%}
                {{ collection_image }}
              {%- endif -%}
              <span class="slide-nav__root-text">
                <span class="slide-nav__root-icon" aria-hidden="true">
                  {% render 'element.icon', name: root_icon_name %}
                </span>
                <span>{{ link.title }}</span>
              </span>
              {% render 'element.icon', name: chevron_icon %}
              <span class="icon__fallback-text visually-hidden">
                {% render 'utility.translate', key: 'actions.expand_submenu', fallback: 'Expand submenu' -%}
              </span>
            </span>
          </button>

          <ul
            class="slide-nav__dropdown"
            data-parent="tier-2-{{ child_list_handle }}"
            data-level="2"
          >
            <li class="slide-nav__item">
              <button
                type="button"
                class="slide-nav__button js-toggle-submenu"
              >
                <span class="slide-nav__link slide-nav__link--back">
                  {% render 'element.icon', name: chevron_icon %}
                  <span>{{ link.title }}</span>
                </span>
              </button>
            </li>

            {% comment %}
            If a collection, automatically add 'view all' link
            — only if the submenu doesn't already contain a link to the same URL
          {% endcomment %}
          {%- assign already_has_view_all = false -%}
          {%- for childlink in link.links -%}
            {%- if childlink.url == link.url -%}
              {%- assign already_has_view_all = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if is_collection and already_has_view_all == false -%}
            <li class="slide-nav__item">
              <a href="{{ link.url }}" class="slide-nav__link">
                <span>
                  {% render 'utility.translate', key: 'actions.view_all', fallback: 'View all' -%}
                </span>
                {% render 'element.icon', name: chevron_icon %}
              </a>
            </li>
          {%- endif -%}

            {%- for childlink in link.links -%}
              {%- liquid
                assign grand_child_list_handle = childlink.title | handleize
                assign grand_child_link_id = grand_child_list_handle | append: link_index

                assign show_menu_icons_submenu = false
                assign show_section_divider_submenu = false
                assign childlink_normalized = childlink.title | downcase | strip
                if childlink_normalized == 'by shape' or childlink_normalized == 'by style' or childlink_normalized == 'по форме'
                  assign show_menu_icons_submenu = true
                  assign show_section_divider_submenu = true
                endif
              -%}

              <li class="slide-nav__item{% if show_section_divider_submenu %} slide-nav__item--divider{% endif %}">
                {%- if childlink.levels > 0 -%}
                  <button
                    type="button"
                    class="slide-nav__button js-toggle-submenu"
                    data-target="tier-3-{{ grand_child_link_id }}"
                    {% if link.active or link.child_active %}
                      data-active="true"
                    {% endif %}
                  >
                    <span class="slide-nav__link slide-nav__sublist-link">
                      <span>{{ childlink.title }}</span>
                      {% render 'element.icon', name: chevron_icon %}
                      <span class="icon__fallback-text visually-hidden">
                        {% render 'utility.translate', key: 'actions.expand_submenu', fallback: 'Expand submenu' -%}
                      </span>
                    </span>
                  </button>
                  <ul
                    class="slide-nav__dropdown{% if show_menu_icons_submenu %} slide-nav__dropdown--icon-grid{% endif %}"
                    data-parent="tier-3-{{ grand_child_link_id }}"
                    data-level="3"
                  >
                    <li class="slide-nav__item">
                      <button
                        type="button"
                        class="slide-nav__button js-toggle-submenu"
                        data-target="tier-2-{{ child_list_handle }}"
                      >
                        <span class="slide-nav__link slide-nav__link--back">
                          {% render 'element.icon', name: chevron_icon %}
                          <span>{{ childlink.title }}</span>
                        </span>
                      </button>
                    </li>

                    {% comment %}
                      If a collection, automatically add 'view all' link
                    {% endcomment %}
                    {%- if childlink.url contains '/collections/' -%}
                      <li class="slide-nav__item{% if show_menu_icons_submenu %} slide-nav__item--full{% endif %}">
                        <a href="{{ childlink.url }}" class="slide-nav__link">
                          <span>
                            {% render 'utility.translate', key: 'actions.view_all', fallback: 'View all' -%}
                          </span>
                          {% render 'element.icon', name: chevron_icon %}
                        </a>
                      </li>
                    {%- endif -%}

                    {%- for grandchildlink in childlink.links -%}
                      <li class="slide-nav__item">
                        <a href="{{ grandchildlink.url }}" class="slide-nav__link{% if show_menu_icons_submenu %} slide-nav__link--icon{% endif %}">
                          {% if show_menu_icons_submenu %}{% render 'shape-menu-icon', shape: grandchildlink.title %}{% endif %}
                          <span>{{ grandchildlink.title | escape }}</span>
                          {% unless show_menu_icons_submenu %}{% render 'element.icon', name: chevron_icon %}{% endunless %}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <a href="{{ childlink.url }}" class="slide-nav__link">
                    <span>{{ childlink.title | escape }}</span>
                    {% render 'element.icon', name: chevron_icon %}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <a href="{{ link.url }}" class="slide-nav__link slide-nav__link--root">
            {%- if have_image -%}
              {{ collection_image }}
            {%- endif -%}

            <span class="slide-nav__root-text">
              <span class="slide-nav__root-icon" aria-hidden="true">
                {% render 'element.icon', name: root_icon_name %}
              </span>
              <span>{{ link.title | escape }}</span>
            </span>
            {% render 'element.icon', name: chevron_icon %}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</mobile-nav>

<script type="module">
  import 'header.mobile-nav'
</script>
