{%- comment -%}
  Renders a shape icon for by-shape menu entries.

  Usage:
    {% render 'shape-menu-icon', shape: link.title %}
{%- endcomment -%}

{% stylesheet %}
  .shape-menu-icon {
    --shape-menu-icon-size: 20px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 var(--shape-menu-icon-size);
    width: var(--shape-menu-icon-size);
    height: var(--shape-menu-icon-size);
    margin-right: 0.65rem;
    line-height: 1;
    color: currentColor;
    opacity: 0.78;
    vertical-align: -0.2em;
  }

  .shape-menu-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    stroke-width: 1.45;
    vector-effect: non-scaling-stroke;
  }

  .site-nav__dropdown-link .shape-menu-icon {
    margin-top: -1px;
  }

  .slide-nav__link > .shape-menu-icon {
    flex: 0 0 var(--shape-menu-icon-size);
  }

  .shape-menu-icon + span {
    min-width: 0;
  }
{% endstylesheet %}

{% liquid
  assign shape = shape | default: ''
  assign shape_name = shape | strip | downcase
-%}

{% if shape_name != blank %}
  <span class="shape-menu-icon" aria-hidden="true">
    {%- if shape_name == 'asscher' -%}
      {% render 'element.icon', name: 'shape-asscher' %}
    {%- elsif shape_name == 'elongated cushion' or shape_name == 'elongated-cushion' -%}
      {% render 'element.icon', name: 'shape-elongated-cushion' %}
    {%- elsif shape_name == 'cushion' -%}
      {% render 'element.icon', name: 'shape-cushion' %}
    {%- elsif shape_name == 'emerald' -%}
      {% render 'element.icon', name: 'shape-emerald' %}
    {%- elsif shape_name == 'heart' -%}
      {% render 'element.icon', name: 'shape-heart' %}
    {%- elsif shape_name == 'marquise' -%}
      {% render 'element.icon', name: 'shape-marquise' %}
    {%- elsif shape_name == 'oval' -%}
      {% render 'element.icon', name: 'shape-oval' %}
    {%- elsif shape_name == 'pear' -%}
      {% render 'element.icon', name: 'shape-pear' %}
    {%- elsif shape_name == 'princess' -%}
      {% render 'element.icon', name: 'shape-princess' %}
    {%- elsif shape_name == 'radiant' -%}
      {% render 'element.icon', name: 'shape-radiant' %}
    {%- elsif shape_name == 'round' -%}
      {% render 'element.icon', name: 'shape-round' %}
    {%- elsif shape_name == 'solitaire' -%}
      {% render 'element.icon', name: 'style-solitaire' %}
    {%- elsif shape_name == 'tree stone' or shape_name == 'three stone' or shape_name == 'three-stone' -%}
      {% render 'element.icon', name: 'style-three-stone' %}
    {%- elsif shape_name == 'bezel' -%}
      {% render 'element.icon', name: 'style-bezel' %}
    {%- endif -%}
  </span>
{% endif %}
