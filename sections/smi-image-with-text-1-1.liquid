<link href="{{ 'smi-image-with-text-1.min.css' | asset_url }}" rel="stylesheet" type="text/css" media="screen" onload="this.onload=null;this.media='all'">
{% comment %}#component#["settings/container-width","settings/media-width","settings/media-position","settings/color-scheme","settings/section-padding","settings/heading.not-alignment","settings/buttons","blocks/color","blocks/background","settings/media-settings","settings/design-mode","settings/animation-settings","settings/heading","settings/image.vars","settings/image"]#endcomponent#{% endcomment %}
<style>
    {% if block_color %}
    {% endif %}
  {% assign colorblock = section.blocks | where: 'type', 'color' | first %}
{% if colorblock %}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      .smi-block-custom-color { 
        --color-background: {{ colorblock.settings.background_color.red }}, {{ colorblock.settings.background_color.green }},{{ colorblock.settings.background_color.blue }};        
        --color-background-alpha: {{ colorblock.settings.background_color.alpha | default: 1 }};
        {% if colorblock.settings.background_gradient_color == blank %}
            --gradient-background: {{ colorblock.settings.background_color }};
        {% else %}
            --gradient-background: {{ colorblock.settings.background_gradient_color }};
        {% endif %}
        --color-foreground-hex: {{ colorblock.settings.text_color }};
        --color-foreground: {{ colorblock.settings.text_color.red }}, {{ colorblock.settings.text_color.green }},{{ colorblock.settings.text_color.blue }};
        --color-subtext: {{ colorblock.settings.subtext_color.red }},{{ colorblock.settings.subtext_color.green }},{{ colorblock.settings.subtext_color.blue }};
        --color-button: {{ colorblock.settings.solid_background_button_color.red }}, {{ colorblock.settings.solid_background_button_color.green }},{{ colorblock.settings.solid_background_button_color.blue }};
        --color-button-text: {{ colorblock.settings.solid_button_label_color.red }}, {{ colorblock.settings.solid_button_label_color.green }},{{ colorblock.settings.solid_button_label_color.blue }};
        --color-secondary-button-text: {{ colorblock.settings.outline_button_color.red }}, {{ colorblock.settings.outline_button_color.green }},{{ colorblock.settings.outline_button_color.blue }};
        --color-shadow: {{ colorblock.settings.shadow_color.red }}, {{ colorblock.settings.shadow_color.green }},{{ colorblock.settings.shadow_color.blue }};
    }
{% endif %}
  #smi-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
;
    --content-max-width: {{ section.settings.content_max_width }}px;;
    --content-alignment: {{ section.settings.content_alignment }};
    --media-position: {{ section.settings.desktop_media_position }};
    --media-ratio: {{ section.settings.media_ratio }};
    {% if section.settings.padding_bottom == 0 %}
      --no-padding-bottom: 48px;
      {% else %}
      --no-padding-bottom: 0px;
    {% endif %}
    --no-padding-top: 0px;
  }
</style>
{%- liquid
  assign media_height = section.settings.media_height
  assign collapse_index = 0
  assign media_shape = section.settings.media_shape
  assign content_position = section.settings.content_position
  assign content_alignment = "smi-justify-content-" | append: section.settings.content_alignment | default: "left"
  assign content_position = "smi-justify-content-" | append: section.settings.content_position | default: "left"
-%}
{%-liquid
    assign media_ratio = section.settings.media_ratio
    assign media_shape = section.settings.media_shape
    if media_shape == 'none'
        assign media_shape = 'hidden'
    endif
    assign media_classes = 'smi-w-100 smi-object-fit-cover '
    if media_shape != 'default' and media_shape != 'round'
        assign media_classes = media_classes | append: media_shape
    endif
    if media_ratio == 'auto' 
        assign media_classes = media_classes | append: ' smi-h-auto'
    else
        assign media_classes = media_classes | append: ' smi-h-100 smi-p-absolute'
    endif
    assign media_wrapper_classes = 'smi-media-wrapper smi-border smi-shadow smi-lh-0 smi-overflow-hidden smi-p-relative smi-' | append: media_shape
    if media_shape contains 'blob'
        assign media_wrapper_classes = media_wrapper_classes | append: ' smi-blob-wrapper smi-has-blob'
    endif
-%}
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-section__inner smi-gradient smi-section-image-with-text-1 smi-color-{{ section.settings.color_scheme }} smi-content-settings"
  data-section="image-with-text-1" data-name="✧Image with text 1">
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <input type="hidden" value="" id="interval_countdown_{{ section.id }}">
  <div class="smi-p-relative smi-{{ section.settings.full_width }}">
    <div class="smi-container-detail smi-d-flex smi-align-items-center smi-container-detail-square smi-container-detail-square-{{ section.settings.desktop_media_width }}">
      <div class="smi-section-block-{{ section.id }} smi-content-detail-padding-desktop-position smi-content-detail-padding-{{ section.settings.desktop_media_position }} smi-d-flex {{ content_position }} smi-rich-content-detail smi-w-100 smi-w-md-mb smi-w-md-{{ 100 | minus: section.settings.desktop_media_width }} smi-content-detail-{{ section.settings.full_width }}"
      >
        {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
        <div class="smi-content-max-width smi-d-flex smi-flex-wrap {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}">
          {% for block in section.blocks %}
            {% if block.type != 'color' and block.type != 'background' %}
              <div class="smi-w-100 smi-d-flex {{ content_alignment }} smi-block-postion-{{ forloop.index }}-{{ section.id }} smi-block-type-{{ block.type }} {{- ' smi-rich-content smi-w-100' -}}
                {% liquid
                  if block.type != 'color' and block.type != 'background'
                    if block.type == 'button'
                      echo ' smi-mb-md'
                    else
                      echo ' smi-mb-lg'
                    endif
                  endif
                %}
                "
                {{ block.shopify_attributes }} 
              >
              {% if block.type == 'heading' %}
                {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div class="smi-heading-component smi-heading-component--align-{{block.settings.heading_alignment}} smi-link-wrapper" {{- block.shopify_attributes -}}    >
  {% liquid
    assign heading = block.settings.heading | strip
    assign sub_heading = block.settings.sub_heading | strip
    assign description = block.settings.description | strip
  %}
  <div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
        {%- assign sub_heading = block.settings.sub_heading | strip -%}
{% if sub_heading != blank %}
    <p class="smi-text-sub smi-mb-xxs smi-heading-component__subheading" data-type="subheading" data-key="s.subheading">{{- sub_heading -}}</p>
{% endif %} 
        {%- assign description = block.settings.description | strip -%}
{%- assign heading = block.settings.heading | strip -%}
{% if heading != blank %}
    <h2 class="{{ block.settings.heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" data-type="heading" data-key="s.heading">{{- heading -}}</h2>
{% endif %} 
        {%- assign description = block.settings.description | strip -%}
{% if description != blank %}
    <div class="smi-text-md smi-heading-component__description smi-format-content" data-type="description" data-key="s.description">{{ description }}</div>
{% endif %}
    </div>
</div>
              {% endif %}
                {% if block.type == 'button' %}
                  <div class="smi-component-buttons smi-button-wrapper
    {%- if block.settings.button_full_width == true %} smi-component-buttons-full-width{%- endif -%}
    {%- unless block.settings.first_button_style contains 'text' or block.settings.second_button_style contains 'text' %} smi-component-buttons--same-width{% endunless -%}">
    {% liquid
    assign button_label = block.settings.first_button_label
    assign button_style = block.settings.first_button_style
    assign button_link = block.settings.first_button_link
%}
{% if button_label != blank %}
    <a
            href="{{- button_link -}}"
            class="smi-button smi-button--first smi-text-button smi-button--{{ button_style | split: '_' | first -}}
                {%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
                {{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
                {{- ' smi-border smi-shadow' -}}">
            <span>
                {{- button_label | escape -}}
            </span>
        {% if button_style contains 'arrow' %}
            <div class="smi-d-flex smi-align-content-center">
                {% render 'smi-icons', icon: 'arrow-right-2' %}
            </div>
        {% endif %}
    </a>
{% endif %}
    {% liquid
    assign button_label = block.settings.second_button_label
    assign button_style = block.settings.second_button_style
    assign button_link = block.settings.second_button_link
%}
{% if button_label != blank %}
    <a
            href="{{- button_link -}}"
            class="smi-button smi-button--second smi-text-button smi-button--{{ button_style | split: '_' | first -}}
                    {%- if button_style contains 'arrow' %} smi-has-icon{% endif %}
                    {{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' -}}
                    {{- ' smi-border smi-shadow' -}}">
                    <span>
                        {{- button_label | escape -}}
                    </span>
        {% if button_style contains 'arrow' %}
            <div class="smi-d-flex smi-align-content-center">
                {% render 'smi-icons', icon: 'arrow-right-2' %}
            </div>
        {% endif %}
    </a>
{% endif %}
</div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% liquid
        assign media_classes = media_classes | remove: "smi-p-absolute" | append: " img-ratio"
      %}
      {% liquid
        if section.settings.full_width == "container-fluid-no-padding"
          assign media_wrapper_classes = media_wrapper_classes | replace: "smi-border", "" | replace: "smi-shadow", "" 
        endif
      %}
      <div class="smi-rich-content-media smi-w-100 smi-w-md-mb smi-w-md-{{ section.settings.desktop_media_width }} {{ settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' | prepend: ' smi-hover-image-' }}">
        {% if media_shape != 'none' %}
          <div class="{{ media_wrapper_classes }}" style="--media-ratio: {{ media_ratio }}" data-type="image" data-key="s.upload_image">
            {%- if section.settings.upload_image != blank -%}
              {% liquid
                assign image_object = section.settings.upload_image
                assign image_classes = media_classes
                assign item_mobile = 1
                assign item_tablet = 2
                assign item_desktop = 2
              %}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
{{
  image_object
  | image_url: width: image_width
  | image_tag: class: image_classes, widths: '400,500,600,700,800,1000,1200,1400,1600,1900,2500', sizes: sizes
}}
            {%- else -%}
              {% assign media_classes = media_classes | append: ' smi-placeholder-light' %}
              {{ 'image' | placeholder_svg_tag: media_classes }}
            {%- endif -%}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
	"name": "✧Image with text 1-1",
	"tag": "section",
	"class": "smi-section image-with-text-1",
	"enabled_on": {
		"templates": [
			"*"
		],
		"groups": [
			"custom.template"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "full_width",
			"label": "Layout",
			"options": [
				{
					"value": "container",
					"label": "Boxed"
				},
				{
					"value": "container-fluid",
					"label": "Full width"
				},
				{
					"value": "container-fluid-no-padding",
					"label": "Full width (no padding)"
				}
			],
			"default": "container"
		},
		{
			"type": "image_picker",
			"id": "upload_image",
			"label": "Image"
		},
		{
			"type": "select",
			"id": "desktop_media_width",
			"label": "Desktop media width",
			"options": [
				{
					"value": "40",
					"label": "S"
				},
				{
					"value": "50",
					"label": "M"
				},
				{
					"value": "60",
					"label": "L"
				}
			],
			"default": "50"
		},
		{
			"type": "select",
			"id": "desktop_media_position",
			"label": "Desktop media position",
			"options": [
				{
					"value": "row-reverse",
					"label": "Left"
				},
				{
					"value": "row",
					"label": "Right"
				}
			],
			"default": "row"
		},
		{
			"type": "select",
			"id": "media_ratio",
			"label": "Media ratio",
			"options": [
				{
					"value": "auto",
					"label": "Adapt"
				},
				{
					"value": "3/2",
					"label": "Landscape"
				},
				{
					"value": "1/1",
					"label": "Square"
				},
				{
					"value": "3/4",
					"label": "Portrait"
				}
			],
			"default": "3/4"
		},
		{
			"type": "select",
			"id": "media_shape",
			"label": "Media shape",
