{% comment %}#component#["settings/heading","settings/slider-arrows","settings/slider-dots","settings/section-padding","settings/testimonial-block","blocks/background","settings/design-mode","settings/animation-settings","layout/slider","settings/image.vars","settings/slider-dots-v2"]#endcomponent#{% endcomment %}
{%- liquid
