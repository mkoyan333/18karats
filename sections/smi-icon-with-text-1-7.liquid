{% comment %}#component#["settings/heading","layout/grid-slider","settings/section-padding","settings/icon-with-text-2","blocks/background","settings/slider-dots-v2.with-info","settings/custom-icons","settings/design-mode","settings/animation-settings","settings/image.vars","settings/slider-dots-v2"]#endcomponent#{% endcomment %}
{% liquid
  assign object_loop = section.blocks | where: 'type', 'icon_with_text'
  assign show_border = false
  assign icon_position = section.settings.icon_position
  if section.settings.content_alignment == 'left'
    assign classes_position_button = 'smi-justify-content-start'
  elsif section.settings.content_alignment == 'right'
    assign classes_position_button = 'smi-justify-content-end'
  else
    assign classes_position_button = 'smi-justify-content-center'
  endif
%}
<style>
    {% if block_color %}
    {% endif %}
  {% assign block_color = section.blocks | where: 'type', 'color' | first %}
{% if block_color %}
    #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }}{
        --color-background: {{ block_color.settings.background_color.red }}, {{ block_color.settings.background_color.green }},{{ block_color.settings.background_color.blue }};
        {% if block_color.settings.background_gradient_color == blank %}
            --gradient-background: {{ block_color.settings.background_color }};
        {% else %}
            --gradient-background: {{ block_color.settings.background_gradient_color }};
        {% endif %}
        --color-foreground: {{ block_color.settings.text_color.red }}, {{ block_color.settings.text_color.green }},{{ block_color.settings.text_color.blue }};
        --color-subtext: {{ block_color.settings.subtext_color.red }},{{ block_color.settings.subtext_color.green }},{{ block_color.settings.subtext_color.blue }};
        --color-secondary-button-text: {{ block_color.settings.outline_button_color.red }}, {{ block_color.settings.outline_button_color.green }},{{ block_color.settings.outline_button_color.blue }};
        --color-shadow: {{ block_color.settings.shadow_color.red }}, {{ block_color.settings.shadow_color.green }},{{ block_color.settings.shadow_color.blue }};
    }
{% endif %}
  #shopify-section-{{ section.id }}{
    --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --heading-alignment: {%- liquid
    case  section.settings.heading_alignment
        when 'left'
         echo 'start'
        when 'right'
         echo 'end'
        else
         echo 'center'
    endcase
-%};
    --content-alignment: {{ section.settings.content_alignment }};
    --media-padding: {{ section.settings.media_padding }}px;
    --offset-swiper-mobile: 0px;
  }
.smi-component-settings-icon-with-text-{text-align:var(--content-alignment)}.smi-component-settings-icon-with-text- .content-right-padding{width:calc(100% - (var(--icon-size) + 24px))}.smi-component-settings-icon-with-text- .content-right{width:calc(100% - var(--icon-size))}.smi-component-settings-icon-with-text- img,.smi-component-settings-icon-with-text- svg{width:var(--icon-size);height:var(--icon-size);object-fit:cover}.smi-component-settings-icon-with-text- .icon-size-normal{width:var(--icon-size);height:var(--icon-size);border-radius:var(--media-radius)}.smi-component-settings-icon-with-text- .icon-size-bg{padding:16px;width:calc(var(--icon-size) + 32px);height:calc(var(--icon-size) + 32px);overflow:hidden;background:var(--icon-background)}.smi-component-settings-icon-with-text- .icon-size{border-radius:500px}.smi-component-settings-icon-with-text- h4 a{margin-left:3px}.smi-component-settings-icon-with-text- svg{stroke:rgb(var(--color-foreground))}.smi-component-settings-icon-with-text- svg path{fill:rgb(var(--color-foreground))}.smi-component-settings-icon-with-text- .text-content{display:flex !important}.smi-component-settings-icon-with-text- .text-content p{letter-spacing:var(--body-letter-spacing-scale, 0)}.smi-component-settings-icon-with-text- .text-content .content{width:100%}.smi-component-settings-icon-with-text- .text-content .smi-content{margin-bottom:0px !important}
</style>
<div
  id="smi-{{ section.id }}"
  class="smi-{{ section.id }} smi-section__inner smi-gradient smi-section-icon-wth-text-1 smi-color-{{ section.settings.color_scheme }}"
  data-section="icon-with-text-1"
  data-name="✧Icon with text 1"
>
  
  {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background'
    endif
  %}
  <div class="smi-container">{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div class="smi-heading-component smi-heading-component--align-{{section.settings.heading_alignment}} smi-link-wrapper" {{- block.shopify_attributes -}}    >
  {% liquid
    assign heading = section.settings.heading | strip
    assign sub_heading = section.settings.sub_heading | strip
    assign description = section.settings.description | strip
  %}
  <div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
        {%- assign sub_heading = section.settings.sub_heading | strip -%}
{% if sub_heading != blank %}
    <p class="smi-text-sub smi-mb-xxs smi-heading-component__subheading" data-type="subheading" data-key="s.subheading">{{- sub_heading -}}</p>
{% endif %} 
        {%- assign description = section.settings.description | strip -%}
{%- assign heading = section.settings.heading | strip -%}
{% if heading != blank %}
    <h2 class="{{ section.settings.heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" data-type="heading" data-key="s.heading">{{- heading -}}</h2>
{% endif %} 
        {%- assign description = section.settings.description | strip -%}
{% if description != blank %}
    <div class="smi-text-md smi-heading-component__description smi-format-content" data-type="description" data-key="s.description">{{ description }}</div>
{% endif %}
    </div>
</div>
</div>
  <div class="smi-section-icon-with-text-1__main smi-overflow-x-clip">
    <div
      class="{% if section.settings.container_full_width %}smi-container-fluid{% else %}smi-container{% endif -%}"
    >
{% liquid
  case border_style
    when 'none'
      assign border_classes = ''
    when 'content'
      assign border_classes = ' smi-content-wrapper'
    when 'blog'
      assign border_classes = ' smi-article-card-wrapper'
      if settings.smi_blog_card_style
        assign card_style = settings.smi_blog_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.blogCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    when 'product'
      assign border_classes = ' smi-product-card-wrapper'
      if settings.smi_card_style
        assign card_style = settings.smi_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.productCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    else
      assign border_classes = ' smi-media-wrapper'
  endcase
  if show_border == false and is_standard != false
    assign is_standard = true
  endif
  if enable_spacing_between_items == null
    assign enable_spacing_between_items = section.settings.enable_spacing_between_items
  endif
  if number_of_columns_on_desktop == null
    assign number_of_columns_on_desktop = section.settings.number_of_columns_on_desktop
  endif
  if number_of_columns_on_mobile == null
    assign number_of_columns_on_mobile = section.settings.number_of_columns_on_mobile
  endif
  if enable_swipe_on_mobile == null
    assign enable_swipe_on_mobile = section.settings.enable_swipe_on_mobile
  endif
  if show_view_all == null
    assign show_view_all = false
  endif
  unless view_all_button_style
    assign view_all_button_style = section.settings.view_all_button_style
  endunless
  unless view_all_button_link
    assign view_all_button_link = '#'
  endunless
%}
{% liquid
  unless object_limit
    assign object_limit = object_loop.size
  endunless
  if enable_spacing_between_items == false
    assign space_between_mobile = '0px'
    assign space_between_desktop = '0px'
  else
    assign space_between_mobile = 'var(--grid-mobile-horizontal-spacing)'
    assign space_between_desktop = 'var(--grid-desktop-horizontal-spacing)'
  endif
  assign slides_per_view_desktop = number_of_columns_on_desktop | times: 1 | at_least: 1
  assign slides_per_view_laptop = 3 | at_most: slides_per_view_desktop
  assign slides_per_view_tablet = 2 | at_most: slides_per_view_desktop
  assign slides_per_view_mobile = number_of_columns_on_mobile | times: 1 | at_most: object_limit | at_least: 1
  if enable_swipe_on_mobile == true
    if object_limit > slides_per_view_mobile
      assign offset_swiper_mobile = '30px'
    else
      assign offset_swiper_mobile = '0px'
    endif
  else
    assign offset_swiper_mobile = '0px'
    assign slides_per_view_mobile = number_of_columns_on_mobile | times: 1
  endif
  if object_limit == slides_per_view_mobile
    assign offset_swiper_mobile = '0px'
  endif
  assign item_mobile = slides_per_view_mobile
  assign item_tablet = slides_per_view_tablet
  assign item_desktop = slides_per_view_desktop
%}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
<style>
  #shopify-section-{{ section.id }} {
      --space-between-mobile: {{ space_between_mobile }};
      --space-between-desktop: {{ space_between_desktop }};
      --item-width-xs: calc((100% - (({{ slides_per_view_mobile | minus: 1 }} * var(--space-between-mobile)) + var(--offset-swiper-mobile,{{ offset_swiper_mobile }})))/ {{ slides_per_view_mobile }});
      --item-width-md: calc((100% - ({{ slides_per_view_tablet | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_tablet }});
      --item-width-lg: calc((100% - ({{ slides_per_view_laptop | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_laptop }});
      --item-width-xl: calc((100% - ({{ slides_per_view_desktop | minus: 1 }} * var(--space-between-desktop)))/ {{ slides_per_view_desktop }});
  }
</style>
<link rel="stylesheet" type="text/css" href="{{ 'smi-layout-grid-slider.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-slider-2.min.js' | asset_url }}" defer data-id="smi-slider-2.min.js"></script>
{% if enable_swipe_on_mobile == true %}
  <link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle-v11.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
  <script src="{{ 'smi-swiper-bundle-v11.min.js' | asset_url }}" defer data-id="smi-swiper-bundle-v11.min.js"></script>
{% endif %}
<div
  class="
    {{- 'smi-layout-grid-slider smi-position-relative' -}}
    {%- if enable_swipe_on_mobile == true %} smi-swipe-on-mobile{% else %} smi-grid-on-mobile{% endif -%}
    {%- if is_standard == true %} smi-style-standard{% else %} smi-style-card{% endif -%}
    {%- liquid
            echo border_classes
            if enable_spacing_between_items == false
                echo ' smi-border-radius-0'
                if show_border == false and is_standard != false
                    echo ' smi-gap-0--standard'
                else
                    echo ' smi-gap-0'
                endif
            else
                echo ' smi-gap-1'
            endif
    -%}
    {%- if object_limit <= slides_per_view_mobile %} smi-only-one-row-xs{% endif -%}
    {%- if object_limit <= slides_per_view_tablet %} smi-only-one-row-md{% endif -%}
    {%- if object_limit <= slides_per_view_laptop %} smi-only-one-row-lg{% endif -%}
    {%- if object_limit <= slides_per_view_desktop %} smi-only-one-row-xl{% endif -%}
  "
>
  <div class="smi-swiper">
    <div class="smi-swiper-wrapper">
      {% assign shape_index = 1 %}
      {% for item in object_loop limit: object_limit %}
        {% liquid
          if exclude contains item.type
            continue
          endif
        %}
        <div
          class="smi-swiper-slide {%- unless show_border == false %} smi-border {%- if enable_spacing_between_items != false %} smi-shadow{% endif -%}{% endunless %}"
          data-swiper-slide-index="{{ forloop.index0 }}"
          {{ item.shopify_attributes }}
        >
          {% assign block = item %}
<div class="smi-component-settings-icon-with-text- smi-d-flex smi-flex-wrap smi-component-settings-icon-with-text-{{ block.id }}">
  {% liquid
    assign button_label = block.settings.button_label
    assign button_label_strip = block.settings.button_label | strip
    assign button_link = block.settings.link1
  %}
  <style>
    .smi-component-settings-icon-with-text-{{ block.id }}{
      --icon-size: {{ block.settings.icon_size }}px;
      {% if block.settings.icon_bg %}
        --icon-background: {{ block.settings.icon_bg }};
      {% endif %}
    }
  </style>
  {% assign sizes = block.settings.icon_size | append: 'px' %}
  {% if icon_position == 'top' %}
    {% if block.settings.upload_icon != blank %}
      <div class="icon-top smi-w-100 smi-d-flex {{ classes_position_button }} smi-mb-sm">
        <div class="{% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size">
          {{
            block.settings.upload_icon
            | image_url: width: 300
            | image_tag: class: 'heading-feature-icon', widths: '100,200,300', sizes: sizes
          }}
        </div>
      </div>
    {% else %}
      {% if block.settings.icon != 'none' %}
        <div class="icon-top smi-w-100 smi-d-flex {{ classes_position_button }} smi-mb-sm">
          <div class="{% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size">{%- render 'smi-custom-icons', icon: block.settings.icon -%}</div>
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
  <div class="text-content smi-w-100">
    {% if icon_position == 'left' %}
      {% if block.settings.upload_icon != blank %}
        <div class="icon-left {% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size smi-mr-sm">
          {{
            block.settings.upload_icon
            | image_url: width: 300
            | image_tag: class: 'heading-feature-icon', widths: '100,200,300', sizes: sizes
          }}
        </div>
      {% else %}
        {% if block.settings.icon != 'none' %}
          <div class="icon-left smi-mr-sm">
            <div class="{% if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)" %} icon-size-bg {% else %} icon-size-normal {% endif %} icon-size">{%- render 'smi-custom-icons', icon: block.settings.icon -%}</div>
          </div>
        {% endif %}
      {% endif %}
    {% endif %}
    <div
      class="{% liquid
        if icon_position == 'top'
          echo 'content'
        else
          if block.settings.icon_bg != blank and block.settings.icon_bg != "rgba(0,0,0,0)"
            echo 'content-right-padding'
          else
            echo 'content-right'
          endif
        endif
      %}
      "
    >
      <h3 class="{{ block.settings.heading_size }} smi-mb-xxs smi-link-wrapper">{{ block.settings.heading }}</h3>
      <div class="smi-content smi-color-text-75 smi-text-md smi-link-wrapper">{{ block.settings.content }}</div>
      {% if button_label != blank and button_label_strip != '' %}
        <div class="smi-button-wrapper smi-mt-md">
          <a
            href="{{- button_link -}}"
            class="smi-button smi-text-button smi-button--text smi-border smi-shadow smi-hover-{{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' }}"
          >
            <span>
              {{- button_label | escape -}}
            </span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
        </div>
      {% endfor %}
    </div>
  </div>
  {% if enable_swipe_on_mobile == true %}
    <div class="smi-slider-controls smi-d-flex smi-d-md-none">
      {%-liquid
    if st_pagination == null 
        assign st_pagination = section.settings.sticky_page_dot_style
    endif
-%}
{% if st_pagination != 'none' %}
  {%- liquid
      assign pagination_style = 'default'
      if st_pagination contains 'text-style'
        assign pagination_style = 'fraction'
      elsif st_pagination == 'dynamic'
        assign pagination_style = 'dynamic'
      elsif st_pagination == 'scrollbar'
        assign pagination_style = 'scrollbar'
      endif
  -%}
  <div class="smi-slider-dot-container smi-pt-xl smi-w-100" data-pagination="{{ pagination_style }}">
    {%- if st_pagination contains 'text-style' -%}
      <div class="smi-component-sticky-page-dot">
        <div class="smi-slider-action">
          <div class="smi-arrows {{ st_pagination }}">
            <div data-control="textPrevSlide" class="smi-arrow dot-arrow-slider smi-text-sm">
              {% render 'smi-icons', icon: 'arrow-left' %}
            </div>
            <div class="text-pagination smi-pagination smi-slider-pagination smi-text-sm smi-arrow"></div>
            <div data-control="textNextSlide" class="smi-arrow dot-arrow-slider smi-text-sm">
              {% render 'smi-icons', icon: 'arrow-right' %}
            </div>
          </div>
        </div>
      </div>
    {%- elsif st_pagination == 'scrollbar' -%}
      <div class="smi-swiper-scrollbar"></div>
    {%- elsif st_pagination == 'dynamic' -%}
      <div class="smi-pagination"></div>
    {%- else -%}
      <div class="dot-container {{ st_pagination }}">
        <div
          class="smi-swiper-pagination smi-pagination"
          {% if st_pagination == 'dot-style-4' %}
            style="display: flex;"
          {% endif %}
        ></div>
      </div>
    {%- endif -%}
  </div>
{% endif %}
    </div>
  {% endif %}
  {%- if show_view_all != false and view_all_button_style != 'none' and object_loop.size > 0 -%}
    <div class="smi-button-wrapper smi-mt-xl smi-d-flex smi-justify-content-center">
      <a
        href="{{- view_all_button_link -}}"
        class="smi-button smi-button--{{- view_all_button_style | split: '_' | first }} smi-text-button {% if view_all_button_style contains "text" %} {% else %}smi-border smi-shadow{% endif %}{{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' }}"
      >
        <span>{{ 'smind.general.view_all' | t }}</span>
        {% if view_all_button_style contains 'arrow' %}{% render 'smi-icons', icon: 'arrow-right-2' %}{% endif %}
      </a>
    </div>
  {%- endif -%}
</div>
{% if no_js != true %}
  <script type="text/javascript">
    window.smind?.initializeWhenReady(() => {
      const containerEl = document.getElementById('smi-{{ section.id }}');
      new SMI_LayoutGridSlider(containerEl);
    }, ['SMI_LayoutGridSlider']);
  </script>
{% endif %}
